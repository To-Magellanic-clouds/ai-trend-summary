# 1. OpenAI原生API
OPENAI_API_KEY=your_openai_api_key_here

# 2. Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# 可选：如果需要自定义Azure端点
AZURE_OPENAI_ENDPOINT=https://your-azure-endpoint.openai.azure.com

# 3. LocalAI（本地部署的兼容服务）
LOCALAI_API_KEY=any_string_will_do  # 通常LocalAI不需要真实密钥
OLLAMA_URL=http://localhost:11434

# 4. HuggingFace Hub
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here

# 5. Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxx

# 6. 其他兼容OpenAI协议的API

DEEPSEEK_API_KEY=
# postgresql
POSTGRES_URL=postgresql+psycopg2://postgres:password@ip:port/db_name
DB_HOST=
DB_PORT=5432
DB_USER=ai_trend
DB_PASSWORD=
DB_NAME=ai_trend



# 向量化SDK配置文件
# 复制此文件为 .env 并根据实际情况修改配置

# ===== Qdrant 向量数据库配置 =====

# 服务器模式（生产环境推荐）
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=false

# 内存模式（开发测试推荐）
# QDRANT_HOST=:memory:
# QDRANT_PORT=

# 文件存储模式（单机应用推荐）
# QDRANT_HOST=./qdrant_data
# QDRANT_PORT=
# QDRANT_PATH=./qdrant_data

# ===== 向量化模型配置 =====

# 推荐的多语言模型（支持中英文）
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_TYPE=sentence_transformers

# 轻量级英文模型（更快速度）
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_TYPE=sentence_transformers

# 高质量英文模型（更好效果）
# EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
# EMBEDDING_MODEL_TYPE=sentence_transformers

# 设备选择（auto/cpu/cuda）
EMBEDDING_DEVICE=auto


# ===== 文本处理配置 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTENT_LENGTH=10000

# ===== 性能配置 =====
BATCH_SIZE=32
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# ===== 日志配置 =====
LOG_LEVEL=INFO

# ===== 配置模式说明 =====
# 
# 1. 内存模式（开发测试）:
#    QDRANT_HOST=:memory:
#    - 优点: 无需外部服务，启动快速
#    - 缺点: 数据不持久化，重启后丢失
#    - 适用: 开发测试、原型验证
#
# 2. 文件存储模式（单机应用）:
#    QDRANT_HOST=./qdrant_data
#    QDRANT_PATH=./qdrant_data
#    - 优点: 数据持久化，无需外部服务
#    - 缺点: 性能较低，不支持分布式
#    - 适用: 小型应用、单机部署
#
# 3. 服务器模式（生产环境）:
#    QDRANT_HOST=localhost
#    QDRANT_PORT=6333
#    - 优点: 高性能，支持分布式，生产级稳定性
#    - 缺点: 需要外部服务，部署复杂
#    - 适用: 生产环境、大规模应用